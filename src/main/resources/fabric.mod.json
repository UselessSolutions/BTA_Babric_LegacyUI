{
  "schemaVersion": 1,
  "id": "legacyui",
  "version": "$version",

  "name": "Better Than Legacy!",
  "description": "A UI overhaul mod for BTA, designed with controllers in mind!",
  "authors": [
    "Useless"
  ],
  "icon": "icon.png",
  "contact": {
    "homepage": "https://github.com/UselessSolutions/BTA_Babric_LegacyUI",
    "sources": ""
  },

  "license": "CC0-1.0",

  "environment": "client",
  "entrypoints": {
    "beforeClientStart": [
      "useless.legacyui.LegacyUI"
    ],
    "modmenu": [
      "useless.legacyui.modmodules.ModMenuModule"
    ],
    "legacyui": [
      "useless.legacyui.api.LegacyUIPlugin"
    ],
    "afterClientStart": [
      "useless.legacyui.gui.screens.options.GuiOptionsPageLegacy"
    ]
  },
  "mixins": [
      "legacyui.mixins.json"
  ],

  "depends": {
    "minecraft": "~7.3",
    "fabricloader": ">=0.15.5"
  },
  "suggests": {
    "modmenu": ">=3.0.0"
  },
  "conflicts": {
    "guiadditions": "*"
  },
  "custom": {
    "modmenu:clientsideOnly": true
  }
}
